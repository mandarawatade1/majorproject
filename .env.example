# ===========================================================================
# PCE Knowledge Management System — environment configuration
#
#   cp .env.example .env      then edit .env
#   .env is gitignored. NEVER commit it.
# ===========================================================================

# --- Application -----------------------------------------------------------
APP_NAME="PCE Knowledge Management System"
APP_ENV=development                 # development | production
DEBUG=true
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Security --------------------------------------------------------------
# Generate a real one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_string_before_first_run
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# Seed admin account, created by the Phase 2 seed script.
ADMIN_EMAIL=admin@pce.local
ADMIN_PASSWORD=change_this_before_first_run

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=pce
POSTGRES_PASSWORD=pce_dev_password
POSTGRES_DB=pce_kms
POSTGRES_HOST=postgres              # "localhost" when running the API outside Docker
POSTGRES_PORT=5432
# Host port mapping (change if 5432 is already taken on your machine)
POSTGRES_HOST_PORT=5432

# --- Redis -----------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_DB=0

# --- ChromaDB --------------------------------------------------------------
CHROMA_HOST=chroma
CHROMA_PORT=8000
# Host port mapping. 8001 avoids clashing with the API on 8000.
CHROMA_HOST_PORT=8001
CHROMA_COLLECTION=pce_chunks

# --- Ollama ----------------------------------------------------------------
# Inside Docker:            http://ollama:11434
# Native Ollama on macOS:   http://host.docker.internal:11434   (much faster —
#                           see "Ollama on macOS" in the README)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_HOST_PORT=11434

# Generator: answers user questions. Judge: scores answers during evaluation.
# They are deliberately from DIFFERENT model families — a model judging its own
# output inflates the scores, which is not a defensible evaluation method.
OLLAMA_GENERATOR_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_JUDGE_MODEL=llama3.1:8b-instruct-q4_K_M

# Set to false to skip the ~9.6 GB model download on first `docker compose up`.
OLLAMA_AUTO_PULL=true
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=180

# --- Embeddings and reranking (HuggingFace, downloaded on first use) --------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
RERANKER_MODEL=BAAI/bge-reranker-base
HF_HOME=/data/hf-cache

# --- Retrieval defaults (Phase 4 tunes these) ------------------------------
CHUNK_MIN_TOKENS=256
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_RATIO=0.15
DENSE_TOP_K=20
SPARSE_TOP_K=20
RRF_K=60
RERANK_TOP_N=5
AGENT_MAX_ITERATIONS=3
AGENT_TIMEOUT_SECONDS=120

# --- Corpus / ingestion ----------------------------------------------------
CORPUS_DIR=/corpus
DATA_DIR=/data
CRAWL_BASE_URLS=https://www.pce.ac.in,https://admissions.pce.ac.in
CRAWL_DELAY_SECONDS=1.0
CRAWL_USER_AGENT=PCE-KMS-AcademicProject/0.1 (B.Tech major project; contact: bpatil23comp@student.mes.ac.in)
CRAWL_RESPECT_ROBOTS=true
CRAWL_MAX_PAGES=1000

# --- Feature flags: the ablation switches for Chapter 4 --------------------
# Turning all of these off yields configuration C0, the naive-RAG baseline.
RAG_STRUCTURE_AWARE_CHUNKING=true
RAG_HYBRID_RETRIEVAL=true
RAG_RERANKING=true
RAG_AGENTIC_LAYER=true
RAG_VERIFICATION=true
